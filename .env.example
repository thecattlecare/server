PORT=5000
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?appName=yourAppName
FRONTEND_URL=https://your-frontend-domain.com
NODE_ENV=production
AUTH_ACCESS_TOKEN_SECRET=your_access_token_secret_here
AUTH_REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
AUTH_ACCESS_TOKEN_EXPIRATION=15m
AUTH_REFRESH_TOKEN_EXPIRATION=7d
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@your-domain.com
